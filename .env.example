# =========================
# Discord Bot 設定
# =========================

# 必須: Discord Bot のトークン
TOKEN=your_discord_bot_token

# 必須: Discord アプリケーションのクライアント ID
CLIENT_ID=your_discord_client_id

# 必須: コマンドを登録する Discord サーバーの ID
GUILD_ID=your_discord_guild_id

# 任意: 将来的な運用ガード用のユーザー ID をカンマ区切りで指定
# 現在の実装では未使用
# 例: 123456789012345678,987654321098765432
PERMITTED_USERS=


# =========================
# LLM 設定
# =========================

# 任意: 使用する LLM プロバイダー
# 未指定時は ollama
# 指定可能: ollama / gemini / openrouter
LLM_PROVIDER=gemini

# 任意: Ollama を使う場合のモデル名
# 未指定時は qwen2.5:3b-instruct
OLLAMA_LLM_MODEL=qwen2.5:3b-instruct

# 任意: Gemini を使う場合のモデル名
# 未指定時は gemini-2.5-flash-lite
GEMINI_LLM_MODEL=gemini-2.5-flash-lite

# 条件付き必須: Gemini を使う場合の API キー
GEMINI_API_KEY=your_gemini_api_key

# 任意: OpenRouter を使う場合のモデル名
# 未指定時は google/gemma-3-27b-it:free
OPENROUTER_LLM_MODEL=google/gemma-3-27b-it:free

# 条件付き必須: OpenRouter を使う場合の API キー
OPENROUTER_API_KEY=your_openrouter_api_key


# =========================
# 音声認識（Moonshine Voice）設定
# =========================

# 任意: STT 常駐ワーカーを使うかどうか
# 1: 有効 / 0: 無効
MOONSHINE_VOICE_PERSISTENT=1

# 任意: 常駐ワーカー数
MOONSHINE_VOICE_WORKERS=1

# 条件付き任意: 常駐ワーカーを使わない場合に利用する Moonshine Voice CLI のパス
MOONSHINE_VOICE_BIN=

# 任意: uv 実行ファイルのパスを明示したい場合に指定
MOONSHINE_VOICE_UV_BIN=

# 任意: moonshine-voice を実行する uv プロジェクトのパス
MOONSHINE_VOICE_UV_PROJECT=

# 任意: moonshine-voice に渡す追加引数
# 例: --language ja --max-tokens-per-second 13.0
MOONSHINE_VOICE_ARGS=

# 任意: STT のタイムアウト秒数を上書きしたい場合に指定
MOONSHINE_VOICE_TIMEOUT_SEC=

# 任意: 1 にすると STT コマンドと出力を詳細ログに出す
MOONSHINE_VOICE_DEBUG=0
